{
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "name": "Unframed Demo IWA",
  "version": "0.0.0",
  "display": "standalone",
  "display_override": [
    {
      "display": "unframed",
      "url_patterns": [
        {
          "pathname": "/unframed/*"
        }
      ]
    }
  ],
  "permissions_policy": {
    "window-management": [
      "self"
    ],
    "cross-origin-isolated": [
      "self"
    ]
  },
  "isolated_storage": true,
  "icons": [
    {
      "src": "/images/icon-192x192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    }
  ]
}
